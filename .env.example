APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PUBLIC_CABINET_ID=1
PUBLIC_BOOKING_HORIZON_DAYS=90
PUBLIC_BOOKING_OPENING_TIME=08:00
PUBLIC_BOOKING_CLOSING_TIME=18:00
PUBLIC_BOOKING_MORNING_START_TIME=09:00
PUBLIC_BOOKING_EVENING_START_TIME=17:00
PUBLIC_BOOKING_SLOT_DURATION=30
PUBLIC_BOOKING_PERIOD_LIMIT=20

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_TTL=86400

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bdddendtiste
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# Multitenancy par base de données (activer après création du registre central)
TENANCY_ENABLED=false
TENANCY_CENTRAL_DOMAINS=localhost
TENANCY_DEFAULT_TENANT=

LANDLORD_DB_HOST=127.0.0.1
LANDLORD_DB_PORT=3306
LANDLORD_DB_DATABASE=cabinets_landlord
LANDLORD_DB_USERNAME=root
LANDLORD_DB_PASSWORD=
LANDLORD_DB_SOCKET=
LANDLORD_DB_CHARSET=utf8mb4
LANDLORD_DB_COLLATION=utf8mb4_unicode_ci

# Identifiants communs par défaut ; chaque cabinet peut les surcharger dans le registre.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_DB_SOCKET=
TENANT_DB_CHARSET=utf8
TENANT_DB_COLLATION=utf8_general_ci

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
